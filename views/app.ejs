<script>
  const searchForm = document.querySelector("#weather-search");
  const citySearch = document.querySelector("#city-search");
  const countrySearch = document.querySelector("#country-search");
  const weatherResult = document.querySelector("#weather-result");
  const skyImage = document.querySelector(".sky-image");
  const skyBackdrop = document.querySelector(".sky-backdrop");
  const contactToggle = document.querySelector(".nav-dropdown-toggle");
  const contactMenu = document.querySelector("#contact-dropdown-menu");
  const revealSky = () => skyBackdrop.classList.add("is-loaded");
  const backgroundFor = (weather, isNight) => {
    const condition = weather.toLowerCase();
    let type = "clearSky";

    if (condition === "thunderstorm") type = "thunderstorm";
    else if (condition === "clear") type = "clearSky";
    else if (condition === "drizzle" || condition === "rain") type = "rainy";
    else if (condition === "snow") type = "snow";
    else if (condition === "clouds") type = "cloudy";
    else if (
      [
        "mist",
        "smoke",
        "haze",
        "dust",
        "fog",
        "sand",
        "ash",
        "squall",
        "tornado",
      ].includes(condition)
    ) {
      type = "mist";
    }

    return `/images/${type}_${isNight ? "night" : "day"}.jpg`;
  };

  const windDirection = (degrees = 0) => {
    const directions = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"];
    return directions[Math.round(degrees / 45) % directions.length];
  };

  const formatTime = (timestamp, timezoneOffset) => {
    const localTime = new Date((timestamp + timezoneOffset) * 1000);
    return new Intl.DateTimeFormat("en", {
      timeZone: "UTC",
      hour: "numeric",
      minute: "2-digit",
    }).format(localTime);
  };

  const countryCodes = {
    canada: "CA",
    india: "IN",
    "united states": "US",
    usa: "US",
    "united kingdom": "GB",
    uk: "GB",
    australia: "AU",
    france: "FR",
    germany: "DE",
    japan: "JP",
  };

  const countryCodeFor = (country) => {
    const trimmed = country.trim();
    if (/^[A-Za-z]{2}$/.test(trimmed)) return trimmed.toUpperCase();

    const normalized = trimmed.toLowerCase();
    return countryCodes[normalized] || trimmed;
  };

  if (contactToggle && contactMenu) {
    const setContactMenuState = (isOpen) => {
      contactMenu.classList.toggle("is-open", isOpen);
      contactToggle.setAttribute("aria-expanded", String(isOpen));
    };

    contactToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = !contactMenu.classList.contains("is-open");
      setContactMenuState(isOpen);
    });

    contactToggle.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        contactToggle.click();
      }
    });

    document.addEventListener("click", (event) => {
      if (!contactToggle.contains(event.target) && !contactMenu.contains(event.target)) {
        setContactMenuState(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setContactMenuState(false);
      }
    });
  }

  if (skyImage && skyBackdrop) {
    skyImage.addEventListener("load", revealSky, { once: true });
    if (skyImage.complete) revealSky();
  }

  [citySearch, countrySearch].forEach((field) => {
    field.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        searchForm.requestSubmit();
      }
    });
  });

  searchForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const city = citySearch.value.trim();
    const country = countrySearch.value.trim();
    const countryCode = country ? countryCodeFor(country) : "";
    if (!city) {
      citySearch.focus();
      return;
    }

    weatherResult.className = "weather-result is-loading";
    weatherResult.textContent = "Checking the forecast...";

    try {
      const response = await fetch(
        `/api/weather?city=${encodeURIComponent(city)}${countryCode ? `&country=${encodeURIComponent(countryCode)}` : ""}`,
      );
      const data = await response.json();
      if (!response.ok)
        throw new Error(data.error || "Unable to fetch weather.");

      document.querySelector("#hero-content").classList.add("has-weather");
      skyBackdrop.classList.remove("is-loaded");
      skyImage.addEventListener("load", revealSky, { once: true });
      skyImage.src = backgroundFor(
        data.weather[0].main,
        data.weather[0].icon.endsWith("n"),
      );
      if (skyImage.complete) requestAnimationFrame(revealSky);
      weatherResult.className = "weather-result";
      weatherResult.replaceChildren();
      const heading = document.createElement("div");
      heading.className = "weather-heading";
      const location = document.createElement("strong");
      location.textContent = `${data.name}, ${data.sys.country}`;
      const summary = document.createElement("span");
      summary.textContent = `${Math.round(data.main.temp)}°C · ${data.weather[0].description}`;
      heading.append(location, summary);

      const details = document.createElement("div");
      details.className = "weather-details";
      const values = [
        ["Temperature", `${Math.round(data.main.temp)}°C`],
        ["Low / High", `${Math.round(data.main.temp_min)}°C / ${Math.round(data.main.temp_max)}°C`],
        ["Humidity", `${data.main.humidity}%`],
        ["Wind", `${data.wind?.speed ?? 0} m/s ${windDirection(data.wind?.deg)}`],
        ["Sunrise", formatTime(data.sys.sunrise, data.timezone)],
        ["Sunset", formatTime(data.sys.sunset, data.timezone)],
      ];

      values.forEach(([label, value]) => {
        const item = document.createElement("div");
        const itemLabel = document.createElement("small");
        itemLabel.textContent = label;
        const itemValue = document.createElement("strong");
        itemValue.textContent = value;
        item.append(itemLabel, itemValue);
        details.append(item);
      });

      weatherResult.append(heading, details);
    } catch (error) {
      weatherResult.className = "weather-result is-error";
      weatherResult.textContent = error.message;
    }
  });
</script>
