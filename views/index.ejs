<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WeatherSync</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/main.css" />
  </head>
  <body class="weather-page">
    <div class="page-wrapper">
      <div class="sky-backdrop" aria-hidden="true">
        <div class="sky-placeholder"></div>
        <img class="sky-image" src="/images/homepage.jpg" alt="" loading="lazy" decoding="async" />
        <div class="sky-wash"></div>
      </div>
      <div class="container-fluid px-4">
        <%- include("partials/header.ejs") %>
      </div>

      <main class="flex-grow-1">
        <section id="hero-content" class="hero-copy container" aria-labelledby="hero-title">
          <p class="eyebrow">WeatherSync</p>
          <h1 id="hero-title">Find your clear forecast.</h1>
          <p class="hero-description">
            Look up a city to see the weather, wherever your day takes you.
          </p>
          <div id="weather-result" class="weather-result" aria-live="polite"></div>
        </section>
      </main>

      <div class="container-fluid px-3">
        <%- include("partials/footer.ejs") %>
      </div>
    </div>
    <%- include("app.ejs") %>
  </body>
</html>